{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipw2",
  "version": "0.1.0",
  "identifier": "com.joat917.clipw2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:21420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clipboard Viewer",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
